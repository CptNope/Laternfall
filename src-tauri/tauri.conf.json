{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lanternfall",
  "version": "1.8.0",
  "identifier": "tech.jeremyanderson.lanternfall",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Lanternfall — A Tale of the Four Flames",
        "width": 1280,
        "height": 960,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "center": true,
        "backgroundColor": "#05040c"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "RolePlayingGame",
    "shortDescription": "A 16-bit-style JRPG",
    "longDescription": "A complete 16-bit-style JRPG drawn and scored entirely in code.",
    "copyright": "© 2026 CptNope. MIT licence.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
