{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shops.schema.json",
  "title": "Lanternfall shops",
  "description": "What each shop sells, in order. A town's map (maps.js) names its shops by id.",
  "type": "object",
  "required": ["shops"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "shops": {
      "type": "object",
      "patternProperties": {
        "^//": { "$ref": "common.schema.json#/$defs/comment" },
        "^[a-z][a-z0-9_]*$": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/id" }, "minItems": 1, "uniqueItems": true, "description": "Item ids, in the order shown." }
      },
      "additionalProperties": false
    }
  }
}
